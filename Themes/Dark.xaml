<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#16161C</Color>
    <Color x:Key="PanelColor">#1F1F28</Color>
    <Color x:Key="BorderColor">#33333F</Color>
    <Color x:Key="FgColor">#E8E8EF</Color>
    <Color x:Key="FgMutedColor">#8B8B98</Color>
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="HoverColor">#2A2A36</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="FgBrush" Color="{DynamicResource FgColor}"/>
    <SolidColorBrush x:Key="FgMutedBrush" Color="{DynamicResource FgMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}"/>
</ResourceDictionary>
