<Window x:Class="Basalt.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在提取"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">

    <StackPanel Margin="20">
        <TextBlock Text="提取文件夹到本地" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="MessageText" Text="正在准备..." FontSize="12.5"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

        <!-- 扫描阶段用 IsIndeterminate 作为 Loading 动画，复制阶段切成确定进度 -->
        <ProgressBar x:Name="Bar" Height="16" Margin="0,14,0,0"
                     Minimum="0" Maximum="100" Value="0"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource PanelBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

        <TextBlock x:Name="DetailText" Text="" FontSize="11" Margin="0,8,0,0"
                   Foreground="{DynamicResource FgMutedBrush}" MinHeight="16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="92" Height="30"
                    Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
