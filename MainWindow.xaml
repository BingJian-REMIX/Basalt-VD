<Window x:Class="Basalt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Basalt.Models"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Title="Basalt — 虚拟磁盘管理器" Height="640" Width="1000"
        MinHeight="480" MinWidth="800">

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="⬛ Basalt — 虚拟磁盘管理器"
                               Foreground="{DynamicResource FgBrush}"
                               VerticalAlignment="Center" Margin="12,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🌙" Width="36" Height="36" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource FgBrush}"
                                ToolTip="切换亮/暗主题" Click="ThemeToggle_Click"
                                FontSize="14"/>
                        <Button Content="─" Width="36" Height="36" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource FgBrush}"
                                Click="Minimize_Click" FontSize="14"/>
                        <Button x:Name="MaximizeButton" Content="🗖" Width="36" Height="36" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource FgBrush}"
                                Click="Maximize_Click" FontSize="13"/>
                        <Button Content="✕" Width="36" Height="36" Padding="0"
                                Background="Transparent" Foreground="{DynamicResource FgBrush}"
                                Click="Close_Click" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 工具栏 + Breadcrumb -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="选择并挂载 VHD" Command="{Binding MountCommand}"/>
                        <Button Content="卸载 VHD" Command="{Binding UnmountCommand}" Margin="8,0,0,0"
                                Background="{DynamicResource FgMutedBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="Breadcrumb"
                               Foreground="{DynamicResource FgMutedBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Text="未挂载"/>
                </Grid>
            </Border>

            <!-- 主区域 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧目录树 -->
                <TreeView Grid.Column="0" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Roots}"
                          SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="📁" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}"/>

                <!-- 右侧文件列表 -->
                <ListView Grid.Column="2" x:Name="FileList"
                          Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile}"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          KeyDown="FileList_KeyDown">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <EventSetter Event="Click" Handler="GridViewColumnHeader_Click"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Header="图标" Width="50"
                                DisplayMemberBinding="{Binding Icon}"/>
                            <GridViewColumn Header="文件名" Width="320"
                                DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="大小" Width="110"
                                DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="修改时间" Width="180"
                                DisplayMemberBinding="{Binding ModifiedText}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="刷新目录" Command="{Binding RefreshCommand}"/>
                            <MenuItem Header="提取到本地" Command="{Binding ExtractCommand}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
                    CornerRadius="0,0,10,10">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource FgMutedBrush}"
                           VerticalAlignment="Center" Margin="12,0" FontSize="11"/>
            </Border>
        </Grid>
    </Border>
</Window>
