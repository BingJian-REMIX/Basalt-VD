<Window x:Class="Basalt.NewDiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建虚拟磁盘"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 亮/暗主题下都保证输入框可读 -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="创建一个带空白 NTFS 分区的 VHDX" FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="纯托管生成：动态 VHDX 容器 → 分区表 → NTFS 格式化，无需管理员权限。"
                   Foreground="{DynamicResource FgMutedBrush}" FontSize="11.5"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="磁盘名称" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Style="{StaticResource InputStyle}"
                     Margin="0,0,0,10" ToolTip="用作 NTFS 卷标（最长 32 字符）与默认文件名"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="保存路径" Style="{StaticResource LabelStyle}"/>
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="浏览..." Width="72" Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click"/>
                <TextBox x:Name="PathBox" Style="{StaticResource InputStyle}"/>
            </DockPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="容量 (GB)" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CapacityBox" Style="{StaticResource InputStyle}"
                     Margin="0,0,0,10" ToolTip="1 – 2048 GB，动态分配"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="分区格式" Style="{StaticResource LabelStyle}"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                <RadioButton x:Name="MbrRadio" Content="MBR（兼容性好）" IsChecked="True"
                             GroupName="PartitionStyle" VerticalAlignment="Center"
                             Foreground="{DynamicResource FgBrush}" FontSize="12.5" Margin="0,0,18,0"/>
                <RadioButton x:Name="GptRadio" Content="GPT（支持大容量）"
                             GroupName="PartitionStyle" VerticalAlignment="Center"
                             Foreground="{DynamicResource FgBrush}" FontSize="12.5"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="HintText" Foreground="{DynamicResource FgMutedBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="88" Height="30" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="创建" Width="100" Height="30" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
