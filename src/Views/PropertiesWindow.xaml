<Window x:Class="Basalt.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件属性"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">

    <StackPanel Margin="18">
        <!-- 头部：图标 + 文件名 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image x:Name="IconImage" Width="32" Height="32"
                   Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 属性表 -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="完整路径" Margin="0,3"
                           Foreground="{DynamicResource FgMutedBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PathText" Margin="0,3"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="大小" Margin="0,3"
                           Foreground="{DynamicResource FgMutedBrush}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SizeText" Margin="0,3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="创建时间" Margin="0,3"
                           Foreground="{DynamicResource FgMutedBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CreatedText" Margin="0,3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="修改时间" Margin="0,3"
                           Foreground="{DynamicResource FgMutedBrush}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ModifiedText" Margin="0,3"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="访问时间" Margin="0,3"
                           Foreground="{DynamicResource FgMutedBrush}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AccessedText" Margin="0,3"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="属性" Margin="0,3"
                           Foreground="{DynamicResource FgMutedBrush}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AttributesText" Margin="0,3"/>
            </Grid>
        </Border>

        <Button Content="关闭" Width="88" Height="30" HorizontalAlignment="Right"
                Margin="0,16,0,0" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
</Window>
