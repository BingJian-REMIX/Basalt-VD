<Window x:Class="Basalt.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="深度清理"
        Width="620" SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        UseLayoutRounding="True">

    <StackPanel Margin="18">
        <TextBlock Text="深度清理" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="扫描挂载盘 / 分区根下的回收站、系统临时目录与系统更新缓存。删除只作用于当前虚拟磁盘，不会触及宿主系统盘。"
                   Foreground="{DynamicResource FgMutedBrush}" FontSize="11.5"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TotalText" FontSize="13" FontWeight="SemiBold" Text="正在扫描..."/>
                <TextBlock x:Name="ScanHint" Text="正在递归统计目录大小..."
                           Foreground="{DynamicResource FgMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ItemsControl x:Name="TargetList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="4,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Display}" FontSize="12.5"/>
                                <TextBlock Text="{Binding Path}" FontSize="10.5"
                                           Foreground="{DynamicResource FgMutedBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                <TextBlock Text="{Binding Note}" FontSize="10.5"
                                           Foreground="{DynamicResource FgMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="HintText" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource FgMutedBrush}" MinHeight="30"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="重新扫描" Width="96" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="Rescan_Click"/>
            <Button x:Name="DeleteButton" Content="一键清理" Width="108" Height="30"
                    Margin="0,0,8,0" Click="Delete_Click"/>
            <Button Content="关闭" Width="80" Height="30" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
