<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\basalt.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LTRData.DiscUtils.Core" Version="1.0.47" />
    <PackageReference Include="LTRData.DiscUtils.Fat" Version="1.0.47" />
    <PackageReference Include="LTRData.DiscUtils.Ntfs" Version="1.0.47" />
    <PackageReference Include="LTRData.DiscUtils.Vmdk" Version="1.0.47" />
    <PackageReference Include="LTRData.DiscUtils.Vhdx" Version="1.0.47" />
    <!-- 光盘镜像的可寻址读取：install.wim 的 XML 元数据写在 4~6 GB 文件尾部，
         用 UDF / ISO9660 直接 seek，避免让 7-Zip 顺序吐出数 GB 数据。 -->
    <PackageReference Include="LTRData.DiscUtils.Udf" Version="1.0.47" />
    <PackageReference Include="LTRData.DiscUtils.Iso9660" Version="1.0.47" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
  </ItemGroup>

  <!-- wimlib 官方 Windows 二进制（GPLv3+ / libwim LGPL）：ISO 精简的 apply / capture / export 引擎。
       放到输出目录的 tools\wimlib-x64\，运行时优先使用；缺失时回退到系统 DISM。
       许可证与来源见 ..\tools\wimlib-x64\VERSION.txt / COPYING*.txt。 -->
  <ItemGroup>
    <None Include="..\tools\wimlib-x64\**\*">
      <Link>tools\wimlib-x64\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 应用图标与标题栏图标：声明为 Resource 后 WPF 会生成 pack URI（/Basalt;component/Assets/...） -->
  <ItemGroup>
    <Resource Include="Assets\basalt.ico" />
    <Resource Include="Assets\basalt-16.png" />
    <Resource Include="Assets\basalt-32.png" />
    <Resource Include="Assets\basalt-48.png" />
    <Resource Include="Assets\basalt-64.png" />
    <Resource Include="Assets\basalt-128.png" />
    <Resource Include="Assets\basalt-256.png" />
  </ItemGroup>

</Project>
